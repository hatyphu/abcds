# Copy this file to .env and fill in your key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: change the model
CLAUDE_MODEL=claude-sonnet-4-6

# Optional: port for the local webhook server
PORT=3000

# TikTok username (without @) that is currently live - required for `npm run live`
TIKTOK_USERNAME=your_tiktok_username

# Port the avatar front-end (OBS Browser Source) connects to for real-time updates
WS_PORT=8081

# How often (ms) to flush a batch of comments and respond to the top-priority one
BATCH_INTERVAL_MS=1500
